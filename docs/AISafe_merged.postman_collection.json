  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (backoffice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Token present', () => pm.expect(body.token).to.be.a('string'));",
                  "pm.environment.set('jwtToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"username\": \"backoffice\", \"password\": \"backoffice123\" }"
            }
          }
        },
        {
          "name": "Login (atcc)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('jwtToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"username\": \"atcc\", \"password\": \"atcc123\" }"
            }
          }
        }
      ]
    },
    {
      "name": "WP#2A — Airports",
      "item": [
        {
          "name": "US106 — Register Airport (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('iataCode returned', () => pm.expect(b.iataCode).to.eql('TST'));",
                  "pm.test('self link present', () => pm.expect(b._links.self).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": "{{baseUrl}}/airports",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"iataCode\": \"TST\",\n  \"name\": \"Test Airport\",\n  \"city\": \"TestCity\",\n  \"country\": \"TestCountry\",\n  \"region\": \"Europe\",\n  \"timezone\": \"Europe/Lisbon\",\n  \"latitude\": 38.7,\n  \"longitude\": -9.1,\n  \"runways\": [\n    { \"name\": \"01/19\", \"length\": 2000.0, \"orientation\": \"010/190\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "US106 — Register Duplicate (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": "{{baseUrl}}/airports",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"iataCode\": \"LIS\",\n  \"name\": \"Test\",\n  \"city\": \"Lisbon\",\n  \"country\": \"Portugal\",\n  \"timezone\": \"Europe/Lisbon\",\n  \"latitude\": 38.7,\n  \"longitude\": -9.1,\n  \"runways\": [{ \"name\": \"03/21\", \"length\": 3805.0, \"orientation\": \"030/210\" }]\n}"
            }
          }
        },
        {
          "name": "US107 — View Airport LIS (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('iataCode = LIS',   () => pm.expect(b.iataCode).to.eql('LIS'));",
                  "pm.test('status field',     () => pm.expect(b.status).to.be.a('string'));",
                  "pm.test('runways array',    () => pm.expect(b.runways).to.be.an('array'));",
                  "pm.test('self link',        () => pm.expect(b._links.self).to.exist);",
                  "pm.test('update-status lk', () => pm.expect(b._links['update-status']).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/airports/LIS"
          }
        },
        {
          "name": "US107 — Airport Not Found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/airports/XXX"
          }
        },
        {
          "name": "US108 — Search by city=Lisbon (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('self link', () => pm.expect(pm.response.json()._links.self).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/airports?city=Lisbon",
              "query": [{ "key": "city", "value": "Lisbon" }]
            }
          }
        },
        {
          "name": "US108 — Search no criteria (empty list ok)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 — never 404 on search', () => pm.response.to.have.status(200));"
