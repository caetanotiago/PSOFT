    {
      "name": "Maintenance (WP#4A)",
      "item": [
        {
          "name": "US115 — Create a Maintenance Template",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": "{{baseUrl}}/api/maintenance-templates",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateName\": \"Revisao Geral\",\n  \"templateType\": \"INSPECTION\",\n  \"flightHours\": 5000,\n  \"calendarDays\": 365,\n  \"checklist\": [\"Verificar fluidos\", \"Verificar travoes\"],\n  \"applicableModels\": [\"A320\"]\n}"
            }
          }
        },
        {
          "name": "US115 — View Maintenance Templates",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-templates/1"
          }
        },
        {
          "name": "US115A — Create a Maintenance Record",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": "{{baseUrl}}/api/maintenance-records",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aircraftRegistration\": \"CS-TVA\",\n  \"templateId\": 1,\n  \"description\": \"Inspecao de Rotina\",\n  \"startDate\": \"2026-06-10\",\n  \"expectedDurationMinutes\": 180,\n  \"componentCategory\": \"Engines\"\n}"
            }
          }
        },
        {
          "name": "US116 — View Maintenance Records of a Specific Aircraft",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-records/aircraft/CS-TVA"
          }
        },
        {
          "name": "US117 — View Total Maintenance Hours for the Fleet",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-records/fleet/maintenance-hours"
          }
        },
        {
          "name": "US119 — Complete a Maintenance Record",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "If-Match", "value": "\"0\"" }
            ],
            "url": "{{baseUrl}}/api/maintenance-records/1/complete",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Inspecao terminada com sucesso. Todos os componentes verificados e validados.\"\n}"
            }
          }
        },
        {
          "name": "Get Maintenance Record by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-records/1"
          }
        }
      ]
    },
    {
      "name": "WP#2A — Airports",
      "item": [
        {
          "name": "US106 — Register Airport",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": "{{baseUrl}}/airports",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"iataCode\": \"TST\",\n  \"name\": \"Test Airport\",\n  \"city\": \"TestCity\",\n  \"country\": \"TestCountry\",\n  \"region\": \"Europe\",\n  \"timezone\": \"Europe/Lisbon\",\n  \"latitude\": 38.7,\n  \"longitude\": -9.1,\n  \"runways\": [\n    { \"name\": \"01/19\", \"length\": 2000.0, \"orientation\": \"010/190\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "US107 — View Airport LIS",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/airports/LIS"
          }
        },
        {
          "name": "US108 — Search by city=Lisbon",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/airports?city=Lisbon",
              "query": [{ "key": "city", "value": "Lisbon" }]
            }
          }
        },
        {
          "name": "US106a — Add Certification LIS",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": "{{baseUrl}}/airports/LIS/certifications",
            "body": {
              "mode": "raw",
              "raw": "{ \"manufacturer\": \"Airbus\", \"modelName\": \"A320\" }"
            }
          }
        },
        {
          "name": "US109 — Update Status CLOSED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": "{{baseUrl}}/airports/OPO/status",
            "body": {
              "mode": "raw",
              "raw": "{ \"state\": \"CLOSED\" }"
            }
          }
        }
      ]
    },
