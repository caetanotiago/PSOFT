    {
      "name": "Maintenance (WP#4A)",
      "item": [
        {
          "name": "US115 — Create a Maintenance Template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code === 201) { pm.environment.set('templateId', pm.response.json().id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": "{{baseUrl}}/api/maintenance-templates",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateName\": \"Revisao Geral\",\n  \"templateType\": \"INSPECTION\",\n  \"flightHours\": 5000,\n  \"calendarDays\": 365,\n  \"checklist\": [\"Verificar fluidos\", \"Verificar travoes\"],\n  \"applicableModels\": [\"A320\"]\n}"
            }
          }
        },
        {
          "name": "US115 — View Maintenance Templates",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-templates/1"
          }
        },
        {
          "name": "US115A — Create a Maintenance Record",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code === 201) { pm.environment.set('recordId', pm.response.json().id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": "{{baseUrl}}/api/maintenance-records",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aircraftRegistration\": \"CS-TVB\",\n  \"templateId\": {{templateId}},\n  \"description\": \"Inspecao de Rotina\",\n  \"startDate\": \"2026-12-01\",\n  \"expectedDurationMinutes\": 180,\n  \"componentCategory\": \"ENGINE\"\n}"
            }
          }
        },
        {
          "name": "US116 — View Maintenance Records of a Specific Aircraft",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-records/aircraft/CS-TVB"
          }
        },
        {
          "name": "US117 — View Total Maintenance Hours for the Fleet",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-records/fleet/maintenance-hours"
          }
        },
        {
          "name": "Get Maintenance Record by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-records/{{recordId}}"
          }
        },
        {
          "name": "US217 — Categorize a Maintenance Record Component",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "If-Match", "value": "0" }
            ],
            "url": "{{baseUrl}}/api/maintenance-records/{{recordId}}/component",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"EXTERIOR\"\n}"
            }
          }
        },
        {
          "name": "US119 — Complete a Maintenance Record",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "If-Match", "value": "1" }
            ],
            "url": "{{baseUrl}}/api/maintenance-records/{{recordId}}/complete",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Inspecao terminada com sucesso.\",\n  \"cost\": 1500.50,\n  \"actualDurationMinutes\": 195,\n  \"aircraftFlightHoursAtCompletion\": 3200.0\n}"
            }
          }
        },
        {
          "name": "US218 — Search Maintenance Records (Filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-records/search?status=COMPLETED&component=EXTERIOR"
          }
        },
        {
          "name": "US219 — View Ongoing Maintenance Activities",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-records/ongoing"
          }
        },
        {
          "name": "US220 — Generate Costs Report (By Aircraft)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-records/reports/costs?type=aircraft"
          }
        },
        {
          "name": "US220 — Generate Costs Report (By Model)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-records/reports/costs?type=model"
          }
        },
        {
          "name": "US221 — View Average Turnaround Time",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/maintenance-records/reports/turnaround-time"
          }
        }
      ]
    },
