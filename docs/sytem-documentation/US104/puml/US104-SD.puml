@startuml US104-SD
autonumber
actor "ATCC" as User

participant ": AircraftRestController" as Ctrl <<Controller>>
participant ": SearchAircraftService" as Service <<Service>>
participant "aircraftRepo : AircraftRepository" as Repo <<Repository>>
participant "pagedAssembler : PagedResourcesAssembler" as PagedAssembler <<Component>>
participant "aircraftAssembler : AircraftAssembler" as Assembler <<Component>>

activate User

User -> Ctrl : GET /api/aircrafts?model={m}&status={s}&year={y}&page={p}&size={sz}
activate Ctrl

Ctrl -> Service : searchAircrafts(model, status, year, pageable)
activate Service

' Build dynamic query and fetch
Service -> Repo : findAll(specification, pageable)
activate Repo
Repo --> Service : Page<Aircraft>
deactivate Repo

Service --> Ctrl : aircraftPage
deactivate Service

' Convert to HATEOAS PagedModel
Ctrl -> PagedAssembler : toModel(aircraftPage, aircraftAssembler)
activate PagedAssembler
PagedAssembler --> Ctrl : PagedModel<EntityModel<AircraftDTO>>
deactivate PagedAssembler

Ctrl --> User : 200 OK (PagedModel)
deactivate Ctrl
deactivate User
@enduml