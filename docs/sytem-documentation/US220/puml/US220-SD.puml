@startuml
autonumber
actor "ATCC" as ATCC
participant "MaintenanceController" as Ctrl
participant "GenerateCostReportUseCase" as UseCase
participant "MaintenanceRecordRepository" as Repo
participant "MaintenanceCostReportDto" as Dto

ATCC -> Ctrl : GET /api/maintenance-records/reports/costs?type={aircraft|model}
activate Ctrl

Ctrl -> UseCase : execute(type)
activate UseCase

UseCase -> Repo : calculateCosts(type)
activate Repo
note right
  JPQL handles the implicit JOIN between
  MaintenanceRecord.aircraftRegistration
  and Aircraft.registrationNumber
end note
Repo --> UseCase : List<CostItem>
deactivate Repo

UseCase -> Dto ** : create(results)
UseCase --> Ctrl : dto
deactivate UseCase

Ctrl --> ATCC : 200 OK (dto)
deactivate Ctrl
@enduml