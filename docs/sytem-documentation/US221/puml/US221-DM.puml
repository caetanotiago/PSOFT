@startuml
hide methods

entity AircraftModel <<Entity>> <<Root>>
entity Aircraft <<Entity>> <<Root>> {
  registrationNumber
}

entity MaintenanceRecord <<Entity>> <<Root>> {
  aircraftRegistration
}

class CompletionNotes <<Value Object>> {
  notes
  completionDate
  cost: Double
  actualDurationMinutes: Integer
}

Aircraft "*" --> "1" AircraftModel : is of type
MaintenanceRecord "1" --> "0..1" CompletionNotes : concluded with
MaintenanceRecord ..> Aircraft : references via registration

note right of CompletionNotes
  'actualDurationMinutes' tracks the true
  turnaround time for the report.
end note
@enduml