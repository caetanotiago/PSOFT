@startuml
skinparam classAttributeIconSize 0

class MaintenanceScheduler {
  + runMaintenanceCheck(): void
}

class AlertService {
  + checkFleetMaintenance(): void
  - isMaintenanceDue(...): boolean
}

interface AircraftRepository {
  + findAll(): List<Aircraft>
}

interface MaintenanceTemplateRepository {
  + findAll(): List<MaintenanceTemplate>
}

interface MaintenanceRecordRepository {
  + findTopByAircraftRegistrationAndMaintenanceTemplateIdAndCompletionNotesIsNotNullOrderByCompletionNotes_CompletionDateDesc(...)
}

interface AlertRepository {
  + save(alert: Alert): Alert
}

class Alert {
  - id: Long
  - message: String
  - createdAt: LocalDate
  - isRead: boolean
}

MaintenanceScheduler ..> AlertService
AlertService ..> AircraftRepository
AlertService ..> MaintenanceTemplateRepository
AlertService ..> MaintenanceRecordRepository
AlertService ..> AlertRepository
AlertService ..> Alert
@enduml