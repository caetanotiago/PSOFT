@startuml
hide methods

entity Aircraft <<Entity>> <<Root>> {
  registrationNumber
  accumulatedFlightHours: Double
}

entity MaintenanceTemplate <<Entity>> <<Root>>
class MaintenanceInterval <<Value Object>> {
  flightHours
  calendarDays
}

entity MaintenanceRecord <<Entity>> <<Root>> {
  aircraftRegistration
  maintenanceTemplateId
}

class CompletionNotes <<Value Object>> {
  completionDate
  aircraftFlightHoursAtCompletion: Double
}

entity Alert <<Entity>> <<Root>> {
  message
  createdAt
  isRead
}

MaintenanceTemplate "1" --> "1" MaintenanceInterval : defines
MaintenanceRecord "1" --> "0..1" CompletionNotes : concluded with
Alert "*" --> "1" Aircraft : targets

note bottom of MaintenanceRecord
  The Scheduler checks the gap between
  Aircraft's current hours/date and the
  latest Record's CompletionNotes.
end note
@enduml