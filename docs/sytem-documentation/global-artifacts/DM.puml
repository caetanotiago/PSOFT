@startuml AISAFE DM
skinparam packageStyle rectangle
skinparam hide empty members
skinparam classAttributeIconSize 0

package "Airport Aggregate" {
    class Airport <<Entity>> <<Root>> {
        - iataCode : IATACode
        - details : AirportDetails
        - status : AirportStatus
        - runways : List<Runway>
        - facilities : List<Facility>
        - contacts : List<AirportContact>
    }
    class IATACode <<Value Object>> {
        - code : String
    }
    class AirportDetails <<Value Object>> {
        - name : String
        - city : String
        - country : String
        - region : String
        - timezone : String
    }
    class Runway <<Value Object>> {
        - name : String
        - length : Double
        - orientation : String
    }
    class AirportContact <<Value Object>> {
        - type : String
        - value : String
        - description : String
    }
    class Facility <<Value Object>> {
        - type : String
        - identifier : String
        - description : String
    }
    class AirportStatus <<Value Object>> {
        - state : String
    }
    
    Airport *-- IATACode
    Airport *-- AirportDetails
    Airport *-- Runway
    Airport *-- AirportContact
    Airport *-- Facility
    Airport *-- AirportStatus
}

package "Aircraft Aggregate" {
    class Aircraft <<Entity>> <<Root>> {
        - registrationNumber : RegistrationNumber
        - status : AircraftStatus
        - seatingCapacity : SeatingCapacity
        - manufacturingDate : ManufacturingDate
        - model : AircraftModel
    }
    class RegistrationNumber <<Value Object>> {
        - number : String
    }
    class AircraftStatus <<Value Object>> {
        - state : String
    }
    class SeatingCapacity <<Value Object>> {
        - totalSeats : Integer
    }
    class ManufacturingDate <<Value Object>> {
        - date : LocalDate
    }
    class AircraftModel <<Entity>> {
        - designation : ModelDesignation
        - specifications : ModelSpecifications
        - features : List<Feature>
    }
    class ModelDesignation <<Value Object>> {
        - manufacturer : String
        - modelName : String
    }
    class ModelSpecifications <<Value Object>> {
        - fuelCapacity : Double
        - maximumRange : Double
        - cruisingSpeed : Double
        - standardCapacity : Integer
    }
    class Feature <<Value Object>> {
        - description : String
    }
    
    Aircraft *-- RegistrationNumber
    Aircraft *-- AircraftStatus
    Aircraft *-- SeatingCapacity
    Aircraft *-- ManufacturingDate
    Aircraft *-- AircraftModel
    AircraftModel *-- ModelDesignation
    AircraftModel *-- ModelSpecifications
    AircraftModel *-- Feature
}

package "Flight Route & Schedule Aggregate" {
    class ScheduledFlight <<Entity>> <<Root>> {
        - flightSchedule : FlightSchedule
        - flightStatus : FlightStatus
        - realDeparture : LocalDateTime
        - realArrival : LocalDateTime
        - route : FlightRoute
    }
    class FlightSchedule <<Value Object>> {
        - date : LocalDate
        - time : LocalTime
    }
    class FlightStatus <<Value Object>> {
        - state : String
    }
    class FlightRoute <<Entity>> {
        - routeID : RouteID
        - distance : RouteDistance
        - requirements : RouteRequirements
        - estimatedFlightTime : EstimatedFlightTime
        - historyLog : List<RouteHistory>
    }
    class RouteID <<Value Object>> {
        - id : String
    }
    class RouteRequirements <<Value Object>> {
        - minRange : Double
        - minCapacity : Integer
    }
    class RouteDistance <<Value Object>> {
        - distance : Double
    }
    class EstimatedFlightTime <<Value Object>> {
        - durationMinutes : Integer
    }
    class RouteHistory <<Value Object>> {
        - changeDate : LocalDateTime
        - description : String
    }
    class RouteStatus <<Value Object>> {
        - state: 
    }
    
    ScheduledFlight *-- FlightSchedule
    ScheduledFlight *-- FlightStatus
    ScheduledFlight *-- FlightRoute
    FlightRoute *-- RouteID
    FlightRoute *-- RouteDistance
    FlightRoute *-- RouteRequirements
    FlightRoute *-- EstimatedFlightTime
    FlightRoute *-- RouteHistory
    FlightRoute *-- RouteState

    ScheduledFlight --> Aircraft : uses >
    FlightRoute --> Airport : origin >
    FlightRoute --> Airport : destination >
}

package "Maintenance Aggregate" {
    class MaintenanceRecord <<Entity>> <<Root>> {
        - recordDetails : RecordDetails
        - component : MaintenanceComponent
        - completionNotes : CompletionNotes
        - template : MaintenanceTemplate
    }
    class RecordDetails <<Value Object>> {
        - description : String
        - startDate : LocalDate
        - expectedDurationMinutes : Integer
    }
    class MaintenanceComponent <<Value Object>> {
        - category : String
    }
    class CompletionNotes <<Value Object>> {
        - notes : String
    }
    class MaintenanceTemplate <<Entity>> {
        - templateName : TemplateName
        - templateType : TemplateType
        - interval : MaintenanceInterval
        - checklist : Checklist
    }
    class TemplateName <<Value Object>> {
        - name : String
    }
    class TemplateType <<Value Object>> {
        - type : String
    }
    class MaintenanceInterval <<Value Object>> {
        - flightHours : Integer
        - calendarDays : Integer
    }
    class Checklist <<Value Object>> {
        - tasks : List<String>
    }
    
    MaintenanceRecord *-- RecordDetails
    MaintenanceRecord *-- MaintenanceComponent
    MaintenanceRecord *-- CompletionNotes
    MaintenanceRecord *-- MaintenanceTemplate
    MaintenanceTemplate *-- TemplateName
    MaintenanceTemplate *-- TemplateType
    MaintenanceTemplate *-- MaintenanceInterval
    MaintenanceTemplate *-- Checklist
    
    MaintenanceRecord --> Aircraft : maintains >
}

package "Inventory Aggregate" {
    class MaintenancePart <<Entity>> <<Root>> {
        - partNumber : PartNumber
        - name : String
        - description : String
        - stockLevel : StockLevel
    }
    class PartNumber <<Value Object>> {
        - number : String
    }
    class StockLevel <<Value Object>> {
        - quantity : Integer
        - minThreshold : Integer
    }
    
    MaintenancePart *-- PartNumber
    MaintenancePart *-- StockLevel
}

' Relacionamento de Certificação entre Agregados
Airport --> AircraftModel : certified for >

@enduml